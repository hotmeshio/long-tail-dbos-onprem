# Copy to .env. Every value here is a local default; docker compose supplies
# the same defaults, so an empty .env runs the site against a cloud stack on
# this machine.

APP_PORT=3700

# Long Tail
JWT_SECRET=local-dev-secret
LT_ADMIN_USER=superadmin
LT_ADMIN_PASSWORD=l0ngt@1l

# DBOS. The executor id stays the same across restarts so the site recovers
# its own orders; the version changes only when workflow code changes shape.
DBOS__VMID=site-1
DBOS__APPVERSION=onprem-v1

# The cloud this site takes work from, and the site's bot on it. On the cloud
# repository, `npm run site-key` prints the key and the bot id.
CLOUD_URL=http://host.docker.internal:3600
CLOUD_API_KEY=
CLOUD_BOT_ID=
# CLOUD_TIMEOUT_MS=15000
# CLOUD_DOWNLOAD_TIMEOUT_MS=600000

# Intake: which cloud role to claim from, how often, and how long a claim holds.
# INTAKE_ROLE=production
INTAKE_POLL_MS=3000
# INTAKE_CLAIM_MINUTES=10080
# INTAKE_BATCH=5

# Reporting an outcome while the cloud is out of reach: first wait, longest wait.
REPORT_RETRY_BASE_SECONDS=2
REPORT_RETRY_CAP_SECONDS=10

# Files of claimed orders, and the address machines fetch them from.
# WORK_DIR=./work
# ASSET_PORT=3001
# ASSET_BASE_URL=http://app:3001

# The print line, its printer, and the lens line
# LINE_FILE=lines/print-line.json
# PRINT_MACHINE=p1s-01
# PRINT_MODEL=model-b
PRINT_TIMEOUT=10m
# LENS_LINE_FILE=lines/lens-line.json
# LENS_HANDOFF_TIMEOUT=30m

# The bin boxed orders are scanned into: its key, where it ships, how many
# orders fill it, and how long it stays open.
# BIN_KEY=bin-7
# BIN_DESTINATION=Portland
# BIN_MAX=12
# BIN_TIMEOUT=4h

# Set a password and the demo people (one per station queue) can sign in.
# PEOPLE_PASSWORD=

# Machines reach the site over MQTT
# MACHINE_TRANSPORT=mqtt
# MACHINE_MQTT_URL=mqtt://mosquitto:1883
# MACHINE_TOPIC_ROOT=line/v1

# Mock machines: seconds one print and one station job take, and the orders
# a machine stops on first try (machine:order pairs, comma separated).
PRINT_SECONDS=5
# STATION_SECONDS=3
# STATION_REJECTS=inspect-01:A-1044
